# ───────────────────── Auth.js ─────────────────────
# Generate a secret: `openssl rand -base64 32`
AUTH_SECRET=

# NEXTAUTH_URL is inferred in most hosts; set explicitly when self-hosting.
# AUTH_URL=http://localhost:3000

# GitHub OAuth (optional — GitHub sign-in button is hidden if these are unset).
# Create an OAuth App: https://github.com/settings/developers
# Authorization callback URL: {AUTH_URL}/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# ───────────────────── Database ─────────────────────
# Neon pooled connection string, e.g.
# postgresql://user:pass@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# ───────────────────── LLM ─────────────────────
OPENAI_API_KEY=
# Optional — override default model (gpt-4o).
# OPENAI_MODEL=gpt-4o
